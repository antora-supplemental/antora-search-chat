{{!-- Search/Ask omnibox — sticky in-flow dock or navbar slot (see ARCHITECTURE.adoc).
     One shell: scope row + one query field + optional Ask result.
     Capability indicators sit at the bottom of the dock. / focuses the field.
     Dock placement is moved to the end of .adt-shell so it occupies space above the footer. --}}
<div
  class="search adt-nav-search adt-search-chat"
  data-adt-search-chat
  data-active-tab="search"
  data-ask-enabled="false"
  data-semantic-enabled="false"
  data-placement="navbar"
  {{#with page.component}}
  data-component-name="{{./name}}"
  data-component-title="{{./title}}"
  {{/with}}
  {{#if page.version}}
  data-version="{{page.version}}"
  {{/if}}
  {{#with page.componentVersion}}
  data-version-display="{{#if ./displayVersion}}{{./displayVersion}}{{else}}{{@root.page.version}}{{/if}}"
  {{/with}}
>
  <button
    type="button"
    class="adt-search-chat__toggle"
    data-adt-search-toggle
    aria-expanded="false"
    aria-controls="adt-search-popover"
    aria-label="Open search"
    hidden
  >
    <svg class="adt-search-chat__toggle-icon" width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/>
      <path d="M16.5 16.5L21 21" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    </svg>
  </button>

  <div
    class="adt-search-chat__popover"
    id="adt-search-popover"
    data-adt-search-popover
  >
    <div class="adt-search-chat__body" data-adt-search-body>
      <form class="adt-search-chat__omnibox" data-adt-search-ask-form>
        <div id="search-field" class="adt-search-chat__field adt-search-compound adt-search-compound--stacked">
          <div class="adt-search-scope-slot adt-search-scope-row" data-adt-search-scope-slot>
            <button
              type="button"
              id="adt-search-scope"
              class="adt-search-scope-trigger"
              data-adt-search-scope-trigger
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-controls="adt-search-scope-menu"
              aria-label="Search scope"
            >
              <span class="adt-search-scope-face" aria-hidden="true" data-adt-search-scope-face>
                <span class="adt-search-scope-label" data-adt-search-scope-label></span>
              </span>
            </button>
            <ul
              id="adt-search-scope-menu"
              class="adt-search-scope-menu"
              role="listbox"
              tabindex="-1"
              hidden
              data-adt-search-scope-menu
              aria-labelledby="adt-search-scope"
            >
              <li
                class="adt-search-scope-option adt-search-scope-option--depth-0"
                role="option"
                data-adt-search-scope-option
                data-scope="all"
                data-depth="0"
                data-label="All docs"
              >
                <span class="adt-search-scope-option-text">All docs</span>
              </li>
              {{#with page.component}}
              <li
                class="adt-search-scope-option adt-search-scope-option--depth-1"
                role="option"
                data-adt-search-scope-option
                data-scope="component"
                data-depth="1"
                data-component-name="{{./name}}"
                data-label="{{#if ./title}}{{./title}}{{else}}{{./name}}{{/if}}"
                aria-selected="true"
              >
                <span class="adt-search-scope-tree-mark" aria-hidden="true">&gt;</span>
                <span class="adt-search-scope-option-text">{{#if ./title}}{{./title}}{{else}}{{./name}}{{/if}}</span>
              </li>
              {{#each ./versions}}
              <li
                class="adt-search-scope-option adt-search-scope-option--depth-2"
                role="option"
                data-adt-search-scope-option
                data-scope="version"
                data-depth="2"
                data-version="{{./version}}"
                data-version-display="{{#if ./displayVersion}}{{./displayVersion}}{{else}}{{./version}}{{/if}}"
              >
                <span class="adt-search-scope-tree-mark" aria-hidden="true">&gt;</span>
                <span class="adt-search-scope-option-text" data-adt-search-scope-option-text></span>
              </li>
              {{/each}}
              {{/with}}
            </ul>
            <input type="hidden" data-adt-search-scope value="component" />
          </div>

          <div class="adt-search-chat__query-slot" data-adt-search-query-slot>
            <div class="adt-search-input-wrap" data-adt-search-input-wrap>
              <span class="adt-search-ph" aria-hidden="true" data-adt-search-ph>
                <span class="adt-search-ph-main">Search or ask...</span><code class="adt-search-ph-code">/</code>
              </span>
              <input
                id="search-input"
                type="text"
                placeholder=""
                autocomplete="off"
                aria-label="Search or ask... /"
                data-adt-search-input
              >
            </div>
            <div class="adt-search-ask-wrap" data-adt-ask-wrap hidden>
              <label class="adt-search-chat__ask-label visually-hidden" for="adt-ask-input">Ask</label>
              <textarea
                id="adt-ask-input"
                class="adt-search-chat__ask-input"
                rows="2"
                placeholder="Ask about this site…"
                data-adt-ask-input
                aria-label="Ask a question about this site"
              ></textarea>
              <kbd class="adt-search-chat__field-hint" aria-hidden="true">?</kbd>
            </div>
          </div>
        </div>

        <div
          class="adt-search-chat__ask-result"
          data-adt-ask-result
          hidden
          aria-live="polite"
        ></div>
      </form>
    </div>

    <div class="adt-search-capabilities" data-adt-search-capabilities aria-label="Search capabilities">
      <label class="adt-search-capability" data-capability="keyword">
        <input type="checkbox" disabled checked data-adt-capability="keyword">
        <span>Keyword</span>
      </label>
      <label class="adt-search-capability" data-capability="semantic">
        <input type="checkbox" disabled data-adt-capability="semantic">
        <span>Semantic</span>
      </label>
      <label class="adt-search-capability" data-capability="chat">
        <input type="checkbox" disabled data-adt-capability="chat">
        <span>Chat</span>
      </label>
    </div>
  </div>
</div>
