{
  "name": "@antora-supplemental/antora-search-chat",
  "version": "0.1.3",
  "description": "Antora extension: wraps @antora/lunr-extension with a Search/Ask omnibox (lunr-first; optional local tier-0 + remote backend). Does not fork lunr.",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "antora",
    "antora-extension",
    "lunr",
    "search",
    "rag",
    "ask"
  ],
  "homepage": "https://github.com/antora-supplemental/antora-search-chat",
  "bugs": {
    "url": "https://github.com/antora-supplemental/antora-search-chat/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antora-supplemental/antora-search-chat.git"
  },
  "scripts": {
    "diagrams:generate": "node scripts/generate-themed-diagrams.mjs",
    "diagrams:check": "node scripts/generate-themed-diagrams.mjs --check"
  },
  "devDependencies": {
    "@dev-centr/mermaid-svg-css-vars": "0.1.2",
    "@dev-centr/themed-svg": "0.1.1",
    "@mermaid-js/mermaid-cli": "11.17.0"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "puppeteer"
    ]
  },
  "peerDependencies": {
    "@antora/lunr-extension": ">=1.0.0-alpha.12"
  },
  "files": [
    "lib/**/*",
    "ui/**/*",
    "ARCHITECTURE.adoc",
    "diagrams/**/*",
    "CHANGELOG.adoc",
    "README.adoc",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
